        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "share"
      ],
      "title": "DominantCluster",
      "type": "object"
    },
    "PaletteEntry": {
