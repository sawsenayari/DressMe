        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price Percentile"
    },
    "dominant_cluster": {
      "$ref": "#/$defs/DominantCluster"
