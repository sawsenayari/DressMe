          "default": null,
          "title": "Economie"
        },
        "image": {
          "maximum": 1,
          "minimum": 0,
          "title": "Image",
          "type": "number"
        }
      },
      "required": [
        "efficacite",
        "image"
      ],
      "title": "PersonaScores",
      "type": "object"
    }
  },
  "description": "Profil de style v1 (objectif 5).",
  "properties": {
    "version": {
      "const": "obj5-profile-v1",
      "default": "obj5-profile-v1",
      "title": "Version",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    },
    "persona": {
      "enum": [
        "efficacite",
        "economie",
        "image",
        "mixte"
      ],
      "title": "Persona",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/PersonaScores"
    },
    "palette": {
      "items": {
        "$ref": "#/$defs/PaletteEntry"
      },
