{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DressMe ItemCard v1",
  "type": "object",
  "required": ["id", "name", "slot", "type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "slot": {"enum": ["top", "bottom", "onepiece", "outer", "footwear", "bag", "accessory"]},
    "type": {"type": "string", "minLength": 1},
    "colour": {"type": "array", "items": {"type": "string"}},
    "usage": {"type": "string"},
    "warmth": {"type": ["number", "null"]},
    "formality": {"type": ["number", "null"]},
    "traditional": {"type": "boolean"}
  },
  "additionalProperties": true
}
