{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DressMe Objective 4 gap result",
  "type": "object",
  "required": ["contract_version", "status", "ranking_ready", "compatibility_progress", "gaps"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "status": {"type": "string", "enum": ["complete", "in_progress", "blocked"]},
    "ranking_ready": {"type": "boolean"},
    "compatibility_progress": {
      "type": "object",
      "required": ["total_pairs", "completed_pairs", "remaining_pairs"],
      "properties": {
        "total_pairs": {"type": "integer", "minimum": 0},
        "completed_pairs": {"type": "integer", "minimum": 0},
        "remaining_pairs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "slot", "gain_lower", "gain_upper", "rank"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "slot": {"enum": ["top", "bottom", "onepiece", "outer", "footwear", "bag", "accessory"]},
          "gain_lower": {"type": "integer", "minimum": 0},
          "gain_upper": {"type": "integer", "minimum": 0},
          "rank": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
