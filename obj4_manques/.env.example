# Local 9Router OpenAI-compatible endpoint.
DRESSME_LLM_BASE_URL=http://127.0.0.1:20128/v1
DRESSME_LLM_API_KEY=replace-with-a-local-9router-api-key
DRESSME_LLM_MODEL=GapDetection
# Compatibility judge route, tested through the same 9Router key.
DRESSME_LLM_COMPAT_MODEL=groq/openai/gpt-oss-120b

# Generation and resource limits.
DRESSME_LLM_TEMPERATURE=0.2
DRESSME_LLM_MAX_TOKENS=600
DRESSME_LLM_JUDGE_MAX_TOKENS=1600
DRESSME_LLM_TIMEOUT=30
DRESSME_LLM_MAX_RETRIES=1
DRESSME_LLM_RETRY_BACKOFF=0.5
DRESSME_LLM_BATCH_DELAY=0
DRESSME_GAP_REPORT=gap_report.json

# Optional model override for image requests using the same local 9Router API key.
# Leave blank to use DRESSME_LLM_MODEL and its configured combo.
DRESSME_LLM_VISION_MODEL=

# Keep false for local use. Remote routers must be explicitly enabled and use HTTPS.
DRESSME_ALLOW_REMOTE_ROUTER=false

# Optional live shopping search. Keep the real key only in .env.
DRESSME_TAVILY_API_KEY=replace-with-a-tavily-api-key
