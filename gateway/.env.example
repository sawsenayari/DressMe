# Copier en gateway\.env (jamais commité) puis relancer run_all.bat.
# Jury (Obj3) dans Outfit Studio : 1 = juges LLM + hybride (texte) et juge visuel, sinon règles seules.
DRESSME_JURY_LLM=1
# Groq (console.groq.com) : juges texte. Gemini (aistudio.google.com) : juges texte en priorité, juge visuel ET reconnaissance
# des photos ajoutées (Obj1 en mode complet ; DRESSME_OBJ1_VLM=aucun pour garder le seul vote des voisins).
LLM_API_KEY=
GEMINI_API_KEY=
# Facultatif : modèles Gemini essayés dans l'ordre (texte et vision).
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# GEMINI_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Facultatif : « Où l'acheter ? » dans Pièces à ajouter (objectif 4), clé gratuite sur tavily.com
DRESSME_TAVILY_API_KEY=
